<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 8.1+: light navigation bar with dark buttons -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/paper</item>
        <item name="android:colorPrimaryDark">@color/paper</item>
        <item name="android:colorAccent">#0B57D0</item>
        <item name="android:statusBarColor">@color/navy_bar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@drawable/splash_window</item>
    </style>
</resources>
