<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the start screen shows the logo on the loading-screen colour (no plain blue screen) -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/paper</item>
        <item name="android:colorPrimaryDark">@color/paper</item>
        <item name="android:colorAccent">#0B57D0</item>
        <item name="android:statusBarColor">@color/navy_bar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
